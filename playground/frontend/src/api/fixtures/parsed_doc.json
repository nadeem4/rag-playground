    },
    {
      "id": "e00017",
      "type": "paragraph",
      "text": "What to measure",
      "order": 17,
      "parent_id": null,
      "page": 3,
      "bbox": [
        72.0,
        541.468017578125,
        163.3679962158203,
        554.8599853515625
      ],
      "level": null,
      "md_start": null,
      "md_end": null
    },
    {
      "id": "e00018",
      "type": "paragraph",
      "text": "Compare strategies on the same parsed document. Count chunks, look at the token distribution, and check recall at ten on a fixed question set. A strategy that wins on one corpus can lose on another, so the comparison is the result, not the ranking.",
      "order": 18,
      "parent_id": null,
      "page": 3,
      "bbox": [
        72.0,
        465.4679870605469,
        490.2119140625,
