    {
      "id": "e00008",
      "type": "paragraph",
      "text": "Recursive character splitting",
      "order": 8,
      "parent_id": null,
      "page": 2,
      "bbox": [
        72.0,
        689.468017578125,
        222.70797729492188,
        702.8599853515625
      ],
      "level": null,
      "md_start": null,
      "md_end": null
    },
    {
      "id": "e00009",
      "type": "paragraph",
      "text": "Recursive splitting tries a list of separators in order: blank lines, then single newlines, then sentence ends, then spaces. It only falls back to a finer separator when a piece is still larger than the budget. The result respects paragraphs where it can and sentences where it must, which is why it is the default in most frameworks.",
      "order": 9,
      "parent_id": null,
      "page": 2,
      "bbox": [
        72.0,
        597.468017578125,
        488.8319091796875,
        674.8599853515625
      ],
      "level": null,
      "md_start": null,
      "md_end": null
    },
    {
      "id": "e00010",
      "type": "paragraph",
      "text": "Heading-aware sections",
      "order": 10,
      "parent_id": null,
      "page": 2,
      "bbox": [
        72.0,
        569.468017578125,
        200.71197509765625,
        582.8599853515625
      ],
      "level": null,
      "md_start": null,
      "md_end": null
    },
    {
      "id": "e00011",
      "type": "paragraph",
      "text": "A heading-aware chunker starts a new chunk at every heading and carries the heading path into the chunk metadata. This only works when the parser reports headings. A plain text extractor returns every line as a paragraph, so the chunker sees one long section and falls back to its token budget.",
      "order": 11,
      "parent_id": null,
      "page": 2,
      "bbox": [
        72.0,
        493.4679870605469,
        492.20391845703125,
        554.8599853515625
      ],
      "level": null,
      "md_start": null,
      "md_end": null
    },
    {
