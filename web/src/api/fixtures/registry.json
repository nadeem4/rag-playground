  "parse": {
    "pdfium": {
      "name": "pdfium",
      "version": "2",
      "stage": "parse",
      "output": "parsed_doc",
      "stackable": false,
      "deterministic": true,
      "cacheable": true,
      "requires": {},
      "provides": {},
      "inputs": {
        "file": {
          "type": "raw_file",
          "variadic": false,
          "ambient": false,
          "required": true
        }
      },
      "config_schema": {
        "properties": {
          "mode": {
            "const": "text",
            "default": "text",
            "title": "Mode",
            "type": "string"
          },
          "join_lines": {
            "default": true,
            "title": "Join Lines",
            "type": "boolean"
          }
        },
        "title": "PdfiumConfig",
        "type": "object"
      }
    }
  },
  "clean": {
    "header_footer_strip": {
      "name": "header_footer_strip",
      "version": "1",
      "stage": "clean",
      "output": "parsed_doc",
      "stackable": true,
      "deterministic": true,
      "cacheable": true,
      "requires": {},
      "provides": {},
      "inputs": {
        "doc": {
          "type": "parsed_doc",
          "variadic": false,
          "ambient": false,
          "required": true
        }
      },
      "config_schema": {
        "properties": {
          "min_page_ratio": {
            "default": 0.5,
            "description": "Fraction of pages a block must appear on, at the same page edge, to count as a running artefact.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Min Page Ratio",
            "type": "number"
          },
          "drop": {
            "default": true,
            "description": "Remove detected blocks from `elements`. When false they are only retyped, which already excludes them from the markdown projection while keeping them visible for inspection.",
            "title": "Drop",
            "type": "boolean"
          }
        },
        "title": "HeaderFooterStripConfig",
        "type": "object"
      }
    },
    "dedupe_blocks": {
      "name": "dedupe_blocks",
      "version": "1",
      "stage": "clean",
      "output": "parsed_doc",
      "stackable": true,
      "deterministic": true,
      "cacheable": true,
      "requires": {},
      "provides": {},
      "inputs": {
        "doc": {
          "type": "parsed_doc",
          "variadic": false,
          "ambient": false,
          "required": true
        }
      },
      "config_schema": {
        "properties": {
          "similarity": {
            "default": 0.95,
            "description": "Minimum difflib ratio to call two blocks duplicates. Only consulted when `scope` is 'near'.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Similarity",
            "type": "number"
          },
          "scope": {
            "default": "exact",
            "description": "'exact' compares normalized text; 'near' compares by similarity ratio.",
            "enum": [
              "exact",
              "near"
            ],
            "title": "Scope",
            "type": "string"
          }
        },
        "title": "DedupeBlocksConfig",
        "type": "object"
      }
    }
  },
