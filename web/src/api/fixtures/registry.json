          "type": "chunk_set",
          "variadic": true,
          "ambient": false,
          "required": true
        }
      },
      "config_schema": {
        "properties": {
          "embedder": {
            "default": "fake-deterministic",
            "title": "Embedder",
            "type": "string"
          },
          "truncate_dim": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Truncate Dim"
          },
          "metric": {
            "default": "cosine",
            "enum": [
              "cosine",
              "l2"
            ],
            "title": "Metric",
            "type": "string"
          },
          "build_fts": {
            "default": true,
            "title": "Build Fts",
            "type": "boolean"
          }
        },
        "title": "LanceDbIndexConfig",
        "type": "object"
      }
    }
  },
