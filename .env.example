# Put your API keys here, in a copy of this file named .env. Each is optional:
# only the chat step needs one, and only for the provider it uses.
# This file is a template; the real .env is gitignored and never committed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# For a custom OpenAI-compatible endpoint. A local server usually needs none.
OPENAI_COMPATIBLE_API_KEY=
